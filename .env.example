# ── Contact form (Web3Forms) ────────────────────────────────────────
# OPTIONAL. Left blank, the form uses the access key built into
# src/components/contact-form/ContactUs.tsx. Set this to deliver
# enquiries to a different inbox — get a key at web3forms.com.
#
# NEXT_PUBLIC_ because Web3Forms access keys are designed to be used
# from the browser. That is not a leak: a key can only deliver mail to
# the inbox it was issued for.
#
# NOTE: public env vars are inlined at BUILD time. Changing one means
# rebuilding, not just restarting.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ── Contact form (server-side alternative) ──────────────────────────
# Only needed if you switch the form to POST /api/sendmail instead of
# Web3Forms. That route is already written, rate-limited to 5 requests per
# hour per client, and sends through SMTP.
NODEMAILER_USER=
NODEMAILER_PASS=
